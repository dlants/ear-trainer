{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": { "noFloatingPromises": "error" }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/*.d.ts",
      "!vamp.ts",
      "!vamp.test.ts",
      "!inventory/patterns.ts",
      "!inventory/songs.ts"
    ]
  }
}
